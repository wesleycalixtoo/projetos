using System;

class ConversorTemperatura
{
    // Kelvin → Fahrenheit
    static double KelvinParaFahrenheit(double kelvin)
    {
        return (kelvin - 273.15) * 1.8 + 32;
    }

    // Fahrenheit → Celsius
    static double FahrenheitParaCelsius(double fahrenheit)
    {
        return (fahrenheit - 32) / 1.8;
    }

    // Celsius → Kelvin
    static double CelsiusParaKelvin(double celsius)
    {
        return celsius + 273.15;
    }

    // Fahrenheit → Kelvin
    static double FahrenheitParaKelvin(double fahrenheit)
    {
        return (fahrenheit - 32) / 1.8 + 273.15;
    }

    static void Main()
    {
        int opcao;

        do
        {
            Console.WriteLine("\n===== CONVERSOR DE TEMPERATURA =====");
            Console.WriteLine("1 - Kelvin  -> Fahrenheit");
            Console.WriteLine("2 - Fahrenheit -> Celsius");
            Console.WriteLine("3 - Celsius -> Kelvin");
            Console.WriteLine("4 - Fahrenheit -> Kelvin");
            Console.WriteLine("0 - Sair");
            Console.Write("Escolha uma opção: ");

            if (!int.TryParse(Console.ReadLine(), out opcao))
            {
                Console.WriteLine("Opção inválida!");
                continue;
            }

            if (opcao == 0)
                break;

            Console.Write("Digite o valor da temperatura: ");
            double valor;
            if (!double.TryParse(Console.ReadLine(), out valor))
            {
                Console.WriteLine("Valor inválido!");
                continue;
            }

            double resultado;

            switch (opcao)
            {
                case 1:
                    resultado = KelvinParaFahrenheit(valor);
                    Console.WriteLine($"{valor} K = {resultado:F2} °F");
                    break;

                case 2:
                    resultado = FahrenheitParaCelsius(valor);
                    Console.WriteLine($"{valor} °F = {resultado:F2} °C");
                    break;

                case 3:
                    resultado = CelsiusParaKelvin(valor);
                    Console.WriteLine($"{valor} °C = {resultado:F2} K");
                    break;

                case 4:
                    resultado = FahrenheitParaKelvin(valor);
                    Console.WriteLine($"{valor} °F = {resultado:F2} K");
                    break;

                default:
                    Console.WriteLine("Opção inválida!");
                    break;
            }

        } while (opcao != 0);

        Console.WriteLine("Programa encerrado.");
    }
}
